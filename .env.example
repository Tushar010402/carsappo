# ─────────────────────────────────────────────────────────────
# Carsappo — environment variables
# Copy to .env (local) or set in your hosting provider's dashboard.
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for SEO canonical URLs, sitemap, emails, invoices)
NEXT_PUBLIC_SITE_URL="https://carsappo.com"

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/carsappo?schema=public"

# Session signing secret — at least 32 random characters. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# First admin account (used by `npm run db:seed`). If ADMIN_PASSWORD is empty a random one is printed.
ADMIN_EMAIL="admin@carsappo.com"
ADMIN_PASSWORD=""
# Where new-order / booking / contact-form alerts are emailed
ADMIN_NOTIFY_EMAIL=""

# ── Razorpay (UPI, cards, net banking) ── https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Settings → Webhooks → URL: https://carsappo.com/api/webhooks/razorpay
# Events: payment.captured, order.paid, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=""

# ── Shiprocket (shipping, AWB, labels, tracking) ── create an API user in Settings → API
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# Settings → API → Webhooks → URL: https://carsappo.com/api/webhooks/shipping  (token sent as x-api-key)
SHIPROCKET_WEBHOOK_TOKEN=""

# ── Email (order confirmations, password resets) — any SMTP provider (Zoho, Google Workspace, SES, Brevo…)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Carsappo <no-reply@carsappo.com>"

# ── Media uploads ──
# Local disk (VPS): files are stored in UPLOAD_DIR and served from /uploads/*
UPLOAD_DIR="./uploads"
# Or any S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces) — required on serverless hosts like Vercel
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
# Hostname of S3_PUBLIC_URL, so next/image can optimise those images (e.g. media.carsappo.com)
NEXT_PUBLIC_S3_PUBLIC_HOST=""

# ── Social proof on the homepage (optional) ──
# Long-lived Instagram API token for the business account (Instagram Feed section)
INSTAGRAM_ACCESS_TOKEN=""
# Google Places API (New) key + Place ID for live Google reviews
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""

# GA4, GTM, Meta Pixel and Google Ads IDs are managed in Admin → SEO & Tracking (not here).
