// Carsappo data model.
// Money is stored as integer paise (₹1 = 100) to avoid floating point errors.
// Product prices are GST-inclusive (standard for Indian B2C retail).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Users & auth
// ─────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  phone                String?
  passwordHash         String
  role                 Role      @default(CUSTOMER)
  // Bumped on logout-everywhere / password change to invalidate existing sessions.
  tokenVersion         Int       @default(0)
  passwordResetHash    String?
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  addresses      Address[]
  orders         Order[]
  wishlist       WishlistItem[]
  reviews        Review[]
  notifications  Notification[]
  returnRequests ReturnRequest[]
  couponUsages   CouponUsage[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────

model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  description     String?
  image           String?
  icon            String? // lucide icon name used in category tiles
  parentId        String?
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[] @relation("CategoryTree")
  sortOrder       Int        @default(0)
  isActive        Boolean    @default(true)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  products Product[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logo      String?
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  sku              String   @unique
  shortDescription String?
  description      String   @default("") // Markdown
  price            Int // selling price in paise, GST inclusive
  mrp              Int? // compare-at price in paise
  discountPercent  Int      @default(0) // derived from price/mrp on save; used for sorting & offers filter
  gstRate          Int      @default(18) // percent
  hsnCode          String?
  stock            Int      @default(0)
  lowStockAlert    Int      @default(5)
  weightGrams      Int      @default(500)
  lengthCm         Int      @default(20)
  breadthCm        Int      @default(15)
  heightCm         Int      @default(10)
  videoUrl         String?
  features         String[]
  tags             String[]
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  // Fits every vehicle (e.g. microfiber cloths, perfumes).
  isUniversal      Boolean  @default(false)
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  isBestSeller     Boolean  @default(false)
  isTrending       Boolean  @default(false)
  isPremium        Boolean  @default(false)
  salesCount       Int      @default(0)
  ratingAvg        Float    @default(0)
  ratingCount      Int      @default(0)
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  images          ProductImage[]
  specs           ProductSpec[]
  faqs            ProductFaq[]
  compatibilities ProductCompatibility[]
  reviews         Review[]
  orderItems      OrderItem[]
  wishlistedBy    WishlistItem[]
  boughtTogether  Product[]              @relation("FrequentlyBoughtTogether")
  boughtWith      Product[]              @relation("FrequentlyBoughtTogether")

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductFaq {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  sortOrder Int     @default(0)

  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// Shop by Vehicle: Brand → Model → Year → Fuel Type
// ─────────────────────────────────────────────────────────────

enum VehicleType {
  CAR
  BIKE
}

model VehicleMake {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  logo      String?
  sortOrder Int            @default(0)
  models    VehicleModel[]
}

model VehicleModel {
  id        String      @id @default(cuid())
  makeId    String
  make      VehicleMake @relation(fields: [makeId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  type      VehicleType @default(CAR)
  yearFrom  Int
  yearTo    Int? // null = still in production
  fuelTypes String[] // PETROL, DIESEL, CNG, EV, HYBRID

  compatibilities ProductCompatibility[]

  @@unique([makeId, slug])
}

model ProductCompatibility {
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)
  // Optional narrowing; null means all years / fuels of the model.
  yearFrom       Int?
  yearTo         Int?
  fuelType       String?

  @@index([productId])
  @@index([vehicleModelId])
}

// ─────────────────────────────────────────────────────────────
// Reviews & social proof
// ─────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  rating     Int
  title      String?
  body       String
  images     String[]
  isVerified Boolean  @default(false) // verified purchase
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId, isApproved])
}

enum TestimonialType {
  IMAGE
  VIDEO
  GOOGLE
}

// Homepage "Customer Reviews": image reviews, video reviews and Google reviews.
model Testimonial {
  id        String          @id @default(cuid())
  type      TestimonialType
  name      String
  location  String?
  rating    Int             @default(5)
  content   String
  mediaUrl  String? // image URL or YouTube/Instagram video URL
  isActive  Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
}

// ─────────────────────────────────────────────────────────────
// Coupons
// ─────────────────────────────────────────────────────────────

enum CouponType {
  PERCENT
  FLAT
}

model Coupon {
  id           String        @id @default(cuid())
  code         String        @unique
  description  String?
  type         CouponType
  value        Int // percent (1-100) or flat amount in paise
  minOrder     Int           @default(0) // paise
  maxDiscount  Int? // paise cap for percent coupons
  usageLimit   Int?
  usedCount    Int           @default(0)
  perUserLimit Int?
  startsAt     DateTime?
  expiresAt    DateTime?
  isActive     Boolean       @default(true)
  isPublic     Boolean       @default(false) // listed in customer dashboard & cart
  createdAt    DateTime      @default(now())
  usages       CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  orderId   String   @unique
  createdAt DateTime @default(now())

  @@index([couponId, email])
}

// ─────────────────────────────────────────────────────────────
// Orders, payments, shipping, invoices
// ─────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING // awaiting payment
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  // Unguessable token that lets guests view their order / invoice (set to 32 random base64url chars at checkout).
  accessToken       String        @unique @default(cuid())
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email             String
  phone             String
  shipName          String
  shipPhone         String
  shipLine1         String
  shipLine2         String?
  shipLandmark      String?
  shipCity          String
  shipState         String
  shipPincode       String
  gstin             String? // customer GSTIN for B2B invoices
  subtotal          Int // sum of line totals (GST inclusive), paise
  discount          Int           @default(0)
  shippingFee       Int           @default(0)
  codFee            Int           @default(0)
  taxTotal          Int           @default(0) // GST contained in total
  total             Int
  couponCode        String?
  status            OrderStatus   @default(PENDING)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  refundedAmount    Int           @default(0) // paise refunded so far (full or partial)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  // Stock is decremented exactly once when the order is confirmed.
  stockCommitted    Boolean       @default(false)
  // Shiprocket
  shiprocketOrderId String?
  shipmentId        String?
  awbCode           String?
  courierName       String?
  trackingUrl       String?
  labelUrl          String?
  estimatedDelivery DateTime?
  // GST invoice
  invoiceNumber     String?       @unique
  invoiceDate       DateTime?
  customerNote      String?
  adminNote         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items          OrderItem[]
  events         OrderEvent[]
  returnRequests ReturnRequest[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  sku       String
  image     String?
  price     Int // unit price, GST inclusive, paise
  quantity  Int
  gstRate   Int
  hsnCode   String?

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKED_UP
  REFUNDED
}

model ReturnRequest {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason    String
  details   String?
  status    ReturnStatus @default(REQUESTED)
  adminNote String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orderId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// Atomic sequences for order and invoice numbers.
model Counter {
  key   String @id
  value Int    @default(0)
}

// ─────────────────────────────────────────────────────────────
// Content: banners, blog
// ─────────────────────────────────────────────────────────────

enum BannerPlacement {
  HOME_HERO
  HOME_PROMO
  SHOP_TOP
}

model Banner {
  id                String          @id @default(cuid())
  placement         BannerPlacement @default(HOME_HERO)
  eyebrow           String?
  title             String
  subtitle          String?
  image             String?
  mobileImage       String?
  ctaLabel          String?
  ctaHref           String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  sortOrder         Int             @default(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model BlogCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  sortOrder   Int     @default(0)
  posts       Post[]
}

model Post {
  id              String       @id @default(cuid())
  title           String
  slug            String       @unique
  excerpt         String
  content         String // Markdown
  coverImage      String?
  categoryId      String
  category        BlogCategory @relation(fields: [categoryId], references: [id])
  author          String       @default("Team Carsappo")
  tags            String[]
  readingMinutes  Int          @default(4)
  isPublished     Boolean      @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([isPublished, publishedAt])
}

// ─────────────────────────────────────────────────────────────
// Daily Car Cleaning (Greater Noida)
// ─────────────────────────────────────────────────────────────

enum ServiceType {
  DAILY_EXTERIOR
  INTERIOR
  TYRE_POLISH
  DASHBOARD_POLISH
}

enum BillingPeriod {
  MONTHLY
  ONE_TIME
}

model ServicePlan {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  serviceType ServiceType
  description String
  price       Int // paise
  period      BillingPeriod  @default(MONTHLY)
  // e.g. "Hatchback", "Sedan", "SUV"
  vehicleSize String?
  features    String[]
  isPopular   Boolean        @default(false)
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  bookings    ServiceBooking[]
}

enum BookingStatus {
  NEW
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

model ServiceBooking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  name          String
  phone         String
  email         String?
  address       String
  society       String?
  pincode       String
  carModel      String
  carNumber     String?
  serviceType   ServiceType
  planId        String?
  plan          ServicePlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  preferredDate DateTime
  preferredSlot String
  notes         String?
  status        BookingStatus @default(NEW)
  adminNote     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Misc
// ─────────────────────────────────────────────────────────────

enum FaqScope {
  GENERAL
  SERVICES
  SHIPPING
}

model Faq {
  id        String   @id @default(cuid())
  scope     FaqScope @default(GENERAL)
  question  String
  answer    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Key/value store for admin-editable settings (store info, SEO, tracking IDs, shipping rules).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
